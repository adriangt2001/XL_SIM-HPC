{
    "num_channels": 25,
    "num_channels_out": 1,
    "embed_dim": 180,
    "depths": [6, 6, 6, 6, 6, 6],
    "num_heads": [6, 6, 6, 6, 6, 6],
    "window_size": 8,
    "mlp_ratio": 2.0,
    "qkv_bias": true,
    "hiddden_dropout_prob": 0.0,
    "attention_probs_dropout_prob": 0.0,
    "drop_path_rate": 0.1,
    "hidden_act": "gelu",
    "use_absolute_embeddings": false,
    "initializer_range": 0.02,
    "layer_norm_eps": 1e-05,
    "upsampler": "pixelshuffle",
    
    "upscale": 4
}